# Copy this file to .env and fill in the values.

# ── Container engine ───────────────────────────────────────────────────────────
# Engine used by the justfile compose recipes (up/down/logs). Defaults to
# `docker`; uncomment and set to `podman` for Podman Compose.
# Left commented on purpose: the justfile does `set dotenv-load`, so a value
# here silently overrides the default for everyone who copies this file.
# CONTAINER_ENGINE=podman

# ── Cloudflare Tunnel (optional) ──────────────────────────────────────────────
# Required only if you uncomment the `cloudflared` service in compose.yaml.
# Get the token from: https://one.dash.cloudflare.com → Networks → Tunnels
CLOUDFLARE_TUNNEL_TOKEN=
